---
import { escape } from "html-escaper";
import type { NavTab } from "@configs/navigation";

interface Props {
  tabs?: NavTab[];
}

const { tabs = [] } = Astro.props;

interface RenderedTab {
  html: string;
  active: boolean;
}

const pathname = Astro.url.pathname.replace(/\/+$/, "") || "/";
const hash = Astro.url.hash;

function normalizePath(value: string): string {
  const [withoutQuery] = value.split("?", 2);
  const trimmed = withoutQuery.replace(/\/+$/, "");
  return trimmed === "" ? "/" : trimmed;
}

function getHrefParts(value: string): { path: string; hash: string } {
  const [pathPart = "", hashPart = ""] = value.split("#", 2);
  return {
    path: normalizePath(pathPart || "/"),
    hash: hashPart ? `#${hashPart}` : ""
  };
}

function isActiveHref(value: string | undefined): boolean {
  if (!value) {
    return false;
  }

  const { path, hash: targetHash } = getHrefParts(value);
  return targetHash ? pathname === path && hash === targetHash : pathname === path;
}

function renderTabs(items: NavTab[], level = 0): RenderedTab[] {
  return items.map((tab, index) => renderTab(tab, level, index));
}

function renderTab(tab: NavTab, level: number, index: number): RenderedTab {
  const children = tab.children?.length ? renderTabs(tab.children, level + 1) : [];
  const active =
    isActiveHref(tab.href) ||
    children.some((child) => child.active) ||
    (pathname === "/" && level === 1 && index === 0 && tab.href?.startsWith("/#"));
  const open = active;
  const childHtml =
    children.length > 0
      ? `<ul class="${level === 0 ? "tabs" : "subtabs"}"${tab.href && !open ? " hidden" : ""}>${children
          .map((child) => child.html)
          .join("")}</ul>`
      : "";

  if (!tab.href) {
    return {
      active,
      html: `<li class="tab-item"><details class="tab-group"${open ? " open" : ""}><summary class="tab-toggle${active ? " is-active" : ""}"><span>${escape(tab.label)}</span><span class="chevron">›</span></summary>${childHtml}</details></li>`
    };
  }

  return {
    active,
    html: `<li class="tab-item"><a href="${escape(tab.href)}"${active ? ' class="is-active"' : ""}>${escape(tab.label)}</a>${childHtml}</li>`
  };
}

const html =
  tabs.length > 0 ? `<ul class="tabs">${renderTabs(tabs).map((tab) => tab.html).join("")}</ul>` : "";
---

{html && <div set:html={html} />}
