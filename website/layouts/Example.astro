---
import { withBase } from "../utils/url";
import packageJson from "../../package.json";
import path from "node:path";

interface Props {
  source: string;
  title?: string;
}

const { source, title = "Example" } = Astro.props;
const isProd = import.meta.env.PROD;

const datGuiVersion = packageJson.devDependencies["dat.gui"].replace(
  /^[^\d]*/,
  "",
);
const statsVersion = packageJson.dependencies["stats.js"].replace(
  /^[^\d]*/,
  "",
);
const marangiVersion = packageJson.dependencies["marangi"].replace(
  /^[^\d]*/,
  "",
);
const hisabatiVersion = packageJson.dependencies["hisabati"].replace(
  /^[^\d]*/,
  "",
);
const vifaaVersion = packageJson.dependencies["vifaa"].replace(
  /^[^\d]*/,
  "",
);
const datGuiUrl = isProd
  ? `https://cdn.jsdelivr.net/npm/dat.gui@${datGuiVersion}/build/dat.gui.module.js`
  : "/node_modules/dat.gui/build/dat.gui.module.js";
const statsUrl = isProd
  ? `https://cdn.jsdelivr.net/npm/stats.js@${statsVersion}/src/Stats.js`
  : "/node_modules/stats.js/src/Stats.js";
const marangiUrl = isProd
  ? `https://cdn.jsdelivr.net/npm/marangi@${marangiVersion}/build/index.module.js`
  : "/node_modules/marangi/build/index.module.js";
const hisabatiUrl = isProd
  ? `https://cdn.jsdelivr.net/npm/hisabati@${hisabatiVersion}/build/index.module.js`
  : "/node_modules/hisabati/build/index.module.js";
const vifaaUrl = isProd
  ? `https://cdn.jsdelivr.net/npm/vifaa@${vifaaVersion}/build/index.module.js`
  : "/node_modules/vifaa/build/index.module.js";
const addonsEntry = path
  .resolve("./examples/addons/rendergraph_gui.js")
  .split(path.sep)
  .join("/");
const renderGraphAddonUrl = isProd
  ? withBase("/examples/addons/rendergraph_gui.js")
  : `/@fs/${addonsEntry}`;

const importMap = JSON.stringify({
  imports: {
    chorama: isProd
      ? withBase("/vendor/chorama/index.module.js")
      : "/src/index.js",
    marangi: marangiUrl,
    hisabati: hisabatiUrl,
    vifaa: vifaaUrl,
    "dat.gui": datGuiUrl,
    "stats.js": statsUrl,
    "@examples/rendergraph_gui": renderGraphAddonUrl,
  },
});

const rewriteAssetLiterals = (script: string): string =>
  script.replace(
    /(["'`])\/?assets\/([^"'`]+)\1/g,
    (_, _quote: string, rest: string) => {
      return "`" + withBase(`/${rest}`) + "`";
    },
  );
const runnerScript = isProd ? rewriteAssetLiterals(source) : source;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <style is:global>
      html,
      body {
        margin: 0;
        width: 100%;
        height: 100%;
        background: #ffffff;
        overflow: hidden;
      }

      canvas {
        background-color: black;
        touch-action: none;
      }
      .dg.ac {
        position: fixed;
        top: 0;
        left: auto;
        right: 0;
        z-index: 10000;
      }
      .performance-monitor {
        position: fixed;
        top: 0%;
        left: 0%;
        right: auto;
        cursor: pointer;
        opacity: 0.9;
        z-index: 10000;
      }
    </style>
    <script type="importmap" set:html={importMap} />
  </head>
  <body>
    <script type="module" set:html={runnerScript} />
  </body>
</html>
