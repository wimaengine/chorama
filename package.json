{
  "name": "chorama",
  "version": "0.1.0",
  "description": "A rendering library",
  "keywords": [
    "rendering",
    "3D",
    "draw",
    "game"
  ],
  "homepage": "https://github.com/waynemwashuma/chorama#readme",
  "bugs": {
    "url": "https://github.com/waynemwashuma/chorama/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/waynemwashuma/chorama.git"
  },
  "license": "MIT",
  "author": "Wayne Mwashuma",
  "type": "module",
  "main": "dist/index.module.js",
  "module": "dist/index.module.js",
  "exports": {
    ".": {
      "import": "./dist/index.module.js"
    }
  },
  "directories": {
    "example": "examples"
  },
  "scripts": {
    "start": "npm run dev",
    "dev": "astro dev",
    "test": "node test",
    "tsc": "tsc -b tsconfig.json",
    "build-website": "npm run build-src && astro build",
    "build-src": "rollup --config rollup.config.js",
    "build": "npm run build-website"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/dat.gui": "^0.7.13",
    "@types/node": "^25.3.3",
    "@types/stats.js": "^0.17.4",
    "astro": "^7.2.2",
    "dat.gui": "^0.7.9",
    "rollup": "^4.52.5",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "wima-docs-website-template": "^0.1.0"
  },
  "dependencies": {
    "hash-it": "^7.0.2",
    "hisabati": "^0.1.0",
    "marangi": "^0.1.0",
    "stats.js": "^0.17.0",
    "vifaa": "^0.3.0"
  }
}
